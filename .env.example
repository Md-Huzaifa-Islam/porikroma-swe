# Settings for docker-compose.prod.yml. Copy to .env and change the secrets.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-to-a-strong-password
POSTGRES_DB=porikroma

# At least 32 random characters, e.g. `openssl rand -hex 32`
JWT_SECRET=change-me-to-a-long-random-secret

# Public port and URL the app is served on
WEB_PORT=8080
FRONTEND_URL=http://localhost:8080
CORS_ORIGINS=*

# Insert the demo accounts (password123) on startup. Keep false for a real deployment.
SEED_DEMO_DATA=false

# Optional integrations
GEMINI_API_KEY=
OPENWEATHER_API_KEY=
EMAIL_PROVIDER=console
EMAIL_API_KEY=
EMAIL_FROM=Porikroma <notifications@porikroma.com>
